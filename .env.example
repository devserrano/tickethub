# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
#   cp .env.example .env
# Cambia los valores marcados con CAMBIAR. Los demás sirven tal cual en local.

# --- Base de datos (MySQL en Docker) ---
DB_HOST=localhost
# 3307 para no chocar con un MySQL instalado en tu máquina (3306).
# Nada de comentarios al final de la línea de un valor: Spring los leería como parte del valor.
DB_PORT=3307
DB_NAME=tickethub
DB_USER=tickethub_app
DB_PASSWORD=CAMBIAR
DB_ROOT_PASSWORD=CAMBIAR

# --- Seguridad ---
JWT_SECRET=CAMBIAR-por-un-secreto-largo-de-al-menos-32-caracteres

# --- Usuarios semilla (se crean al arrancar la app con hash BCrypt) ---
ADMIN_PASSWORD=CAMBIAR
DEMO_PASSWORD=CAMBIAR

# --- Correo (Mailpit en local: bandeja en http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@tickethub.local

# --- Archivos (MinIO en local) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tickethub-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

FRONTEND_URL=http://localhost:5173
